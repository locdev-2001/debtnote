{
  "name": "@debtnote/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsup src/main.ts --config ../../tsup.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@debtnote/database": "workspace:*",
    "@debtnote/application": "workspace:*",
    "@debtnote/contracts": "workspace:*",
    "pg": "catalog:",
    "ioredis": "catalog:",
    "tesseract.js": "catalog:",
    "@debtnote/jobs": "workspace:*",
    "@debtnote/runtime": "workspace:*",
    "bullmq": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
