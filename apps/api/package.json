{
  "name": "@debtnote/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/main.ts",
    "build": "tsup src/main.ts --config ../../tsup.config.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@debtnote/database": "workspace:*",
    "@debtnote/jobs": "workspace:*",
    "@debtnote/rpc": "workspace:*",
    "@debtnote/runtime": "workspace:*",
    "@trpc/server": "catalog:",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
