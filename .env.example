APP_ORIGIN=http://localhost:5173
# Production: APP_ORIGIN phải là domain HTTPS và APP_DATA_KEY là 64 ký tự hex riêng.
# Local tự tạo khóa bền vững tại .local/data-key; không xóa khóa nếu còn QR đã lưu.
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=5173
LOG_LEVEL=info

# Cổng riêng để không trùng PostgreSQL và Redis đang chạy trên máy.
DATABASE_URL=postgresql://debtnote:debtnote@127.0.0.1:55432/debtnote
REDIS_URL=redis://127.0.0.1:56379/0

# Key OpenRouter để đọc bill bằng AI; để trống thì chỉ dùng tesseract.
RECEIPT_AI_API_KEY=
